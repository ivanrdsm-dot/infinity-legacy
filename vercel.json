{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:fn(ad-precheck|compose|dashboard|wa-dashboard|wa-register-retry|wa-meta-verify-check)",
      "destination": "/api/tools?fn=:fn"
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "functions": {
    "api/*.js": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "crons": [
    { "path": "/api/wa-cron-followup", "schedule": "0 16 * * *" },
    { "path": "/api/wa-meta-verify-check", "schedule": "0 15 * * *" }
  ]
}
